{
  "files.exclude": {},
  "cSpell.words": ["colour", "Prefs", "Refetched", "stackable", "Unassignment"],
  "cSpell.ignoreWords": ["hkgx", "webp"],
  "typescript.tsdk": "node_modules/typescript/lib",
